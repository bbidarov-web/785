NODE_ENV=development
PORT=4000

# postgresql://<user>:<password>@<host>:5432/<db>?schema=public
DATABASE_URL=postgresql://kontur785:kontur785@localhost:5432/kontur785?schema=public

# openssl rand -hex 32
COOKIE_SECRET=

# openssl rand -hex 32 — отдельный секрет от COOKIE_SECRET: подпись цепочки
# журнала действий (audit/chain.ts). Утечка COOKIE_SECRET не должна означать,
# что журнал можно подделать, и наоборот.
AUDIT_LOG_SECRET=

CORS_ORIGIN=http://localhost:3000

# SERVER.md §7 "до запуска решить": оставьте пустыми для dev — коды 2FA/сброса
# уйдут в консоль сервера (ConsoleNotifier), а не по смс/почте. Заданы — коды и
# дайджест уходят реально: SMS_PROVIDER_API_KEY через SMS.ru, EMAIL_PROVIDER_API_KEY
# через Resend (infra/providers/httpNotifier.ts; другой провайдер — замените адаптер).
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=Контур 785 <noreply@standart-kachestva.ru>

# Файловое хранилище (фото находок обхода, README «Что дальше» п.1).
# local — диск сервера (по умолчанию, годится для одного инстанса); s3 — любой
# S3-совместимый провайдер, не только AWS (Selectel/Yandex Object Storage/VK Cloud —
# актуально при хостинге в РФ). FILES_S3_BUCKET обязателен, если FILES_DRIVER=s3.
FILES_DRIVER=local
FILES_DIR=./var/uploads
# FILES_S3_BUCKET=
# FILES_S3_REGION=ru-central1
# FILES_S3_ENDPOINT=https://storage.yandexcloud.net
# FILES_S3_ACCESS_KEY_ID=
# FILES_S3_SECRET_ACCESS_KEY=
# FILES_S3_FORCE_PATH_STYLE=true
